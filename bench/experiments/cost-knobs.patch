 fn link(adjacent: &mut [u32; 26], a: u8, b: u8) {
     let (ia, ib) = ((a - b'a') as usize, (b - b'a') as usize);
     adjacent[ia] |= 1 << ib;
     adjacent[ib] |= 1 << ia;
 }
 
